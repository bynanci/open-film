{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@openfilm/core": ["packages/core/src/index.ts"],
      "@openfilm/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@openfilm/analysis": ["packages/analysis/src/index.ts"],
      "@openfilm/metadata": ["packages/metadata/src/index.ts"],
      "@openfilm/events": ["packages/events/src/index.ts"],
      "@openfilm/story": ["packages/story/src/index.ts"],
      "@openfilm/solver": ["packages/solver/src/index.ts"],
      "@openfilm/exporters": ["packages/exporters/src/index.ts"],
      "@openfilm/catalog": ["packages/catalog/src/index.ts"],
      "@openfilm/media": ["packages/media/src/index.ts"],
      "@openfilm/render": ["packages/render/src/index.ts"],
      "@openfilm/application": ["packages/application/src/index.ts"],
      "@openfilm/ui": ["packages/ui/src/index.ts"],
      "@openfilm/template-proposal": ["templates/proposal-film/src/index.ts"],
      "@openfilm/source-pixel": ["packages/source-pixel/src/index.ts"],
      "@openfilm/source-insta360": ["packages/source-insta360/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "templates/**/*.ts",
    "apps/cli/**/*.ts",
    "apps/server/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "apps/desktop/src-tauri"]
}
