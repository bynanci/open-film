{
  "name": "openfilm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "openfilm": "./dist/cli/index.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cli": "tsx apps/cli/src/index.ts",
    "server": "tsx apps/server/src/index.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/integration/**\" --exclude \"packages/application/tests/**\" --exclude \"packages/media/tests/**\" --exclude \"packages/render/tests/**\" --exclude \"packages/catalog/tests/**\"",
    "test:integration": "vitest run packages/application/tests packages/media/tests packages/render/tests packages/catalog/tests tests/integration",
    "test:e2e": "playwright test",
    "test:i18n": "tsx scripts/check-i18n.ts",
    "build": "node scripts/build.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:interchange": "tsx scripts/verify-interchange.ts",
    "test:native": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@openfilm/analysis": "workspace:*",
    "@openfilm/application": "workspace:*",
    "@openfilm/catalog": "workspace:*",
    "@openfilm/core": "workspace:*",
    "@openfilm/events": "workspace:*",
    "@openfilm/exporters": "workspace:*",
    "@openfilm/media": "workspace:*",
    "@openfilm/metadata": "workspace:*",
    "@openfilm/plugin-sdk": "workspace:*",
    "@openfilm/render": "workspace:*",
    "@openfilm/solver": "workspace:*",
    "@openfilm/source-insta360": "workspace:*",
    "@openfilm/source-pixel": "workspace:*",
    "@openfilm/story": "workspace:*",
    "exiftool-vendored.pl": "13.59.3",
    "@openfilm/provider-whisper": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.6",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  }
}
