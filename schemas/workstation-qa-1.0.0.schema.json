{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openfilm:workstation-qa:1.0.0",
  "title": "OpenFilm Workstation QA Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSha", "createdAt", "environment", "gates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "release", "arch", "node", "memoryBytes"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string" },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "gpu": { "type": "string" },
        "openfilmVersion": { "type": "string" },
        "ffmpegVersion": { "type": "string" },
        "resolveVersion": { "type": "string" },
        "resolveEdition": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolve",
        "asr",
        "llm",
        "gpu",
        "camera",
        "4k",
        "windows-installer",
        "cross-process-recovery"
      ],
      "properties": {
        "resolve": { "$ref": "#/$defs/gate" },
        "asr": { "$ref": "#/$defs/gate" },
        "llm": { "$ref": "#/$defs/gate" },
        "gpu": { "$ref": "#/$defs/gate" },
        "camera": { "$ref": "#/$defs/gate" },
        "4k": { "$ref": "#/$defs/gate" },
        "windows-installer": { "$ref": "#/$defs/gate" },
        "cross-process-recovery": { "$ref": "#/$defs/gate" }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observations"],
      "properties": {
        "status": {
          "enum": ["not-run", "passed", "failed", "blocked"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "blocker": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "kind"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "status"],
            "properties": {
              "check": { "type": "string", "minLength": 1 },
              "status": {
                "enum": ["pass", "fail", "unavailable", "info"]
              },
              "expected": { "type": "string" },
              "actual": { "type": "string" },
              "evidence": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
